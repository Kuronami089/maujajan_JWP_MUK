  "JWP DB Transaction": {
    "scope": "php",
    "prefix": "jwp-transaction",
    "description": "Template Database Transaction untuk Checkout / Order Pesanan",
    "body": [
      "DB::beginTransaction();",
      "try {",
      "    // 1. Simpan Header Pesanan",
      "    \\$order = Order::create([",
      "        'customer_name' => \\$request->customer_name,",
      "        'customer_email' => \\$request->customer_email,",
      "        'total_price' => 0,",
      "        'status' => 'Pending',",
      "    ]);",
      "",
      "    \\$totalPrice = 0;",
      "    // 2. Looping Rincian Pesanan",
      "    foreach (\\$request->items as \\$itemId => \\$quantity) {",
      "        if (\\$quantity > 0) {",
      "            \\$item = ${1:Event}::findOrFail(\\$itemId);",
      "            \\$subtotal = \\$item->ticket_price * \\$quantity;",
      "            \\$totalPrice += \\$subtotal;",
      "",
      "            OrderDetail::create([",
      "                'order_id' => \\$order->id,",
      "                '${2:event}_id' => \\$item->id,",
      "                'quantity' => \\$quantity,",
      "                'subtotal' => \\$subtotal,",
      "            ]);",
      "        }",
      "    }",
      "",
      "    // 3. Update Total Harga dan Simpan Permanen",
      "    \\$order->update(['total_price' => \\$totalPrice]);",
      "    DB::commit();",
      "",
      "    return redirect()->back()->with('success', 'Pesanan berhasil dibuat!');",
      "} catch (\\Exception \\$e) {",
      "    DB::rollBack();",
      "    return redirect()->back()->with('error', 'Gagal memproses pesanan: ' . \\$e->getMessage());",
      "}"
    ]
  }
