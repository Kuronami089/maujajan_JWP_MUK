  "JWP Transaction Checkout": {
    "scope": "php",
    "prefix": "jwp-transaction",
    "description": "Logika Transaksi Pemesanan DB::beginTransaction persis OrderController",
    "body": [
      "DB::beginTransaction();",
      "try {",
      "    // 1. Simpan Pesanan Utama",
      "    \\$order = Order::create([",
      "        'customer_name' => \\$request->customer_name,",
      "        'customer_email' => \\$request->customer_email ?? \\$request->table_number,",
      "        'total_price' => 0,",
      "        'status' => 'Pending',",
      "    ]);",
      "",
      "    \\$totalPrice = 0;",
      "    // 2. Looping Item yang dipesan",
      "    foreach (\\$request->items as \\$itemId => \\$quantity) {",
      "        if (\\$quantity > 0) {",
      "            \\$item = ${1:Food}::findOrFail(\\$itemId);",
      "            \\$price = \\$item->price ?? \\$item->ticket_price;",
      "            \\$subtotal = \\$price * \\$quantity;",
      "            \\$totalPrice += \\$subtotal;",
      "",
      "            OrderDetail::create([",
      "                'order_id' => \\$order->id,",
      "                '${3:food}_id' => \\$item->id,",
      "                'quantity' => \\$quantity,",
      "                'subtotal' => \\$subtotal,",
      "            ]);",
      "        }",
      "    }",
      "",
      "    // 3. Update Total Harga Akhir",
      "    \\$order->update(['total_price' => \\$totalPrice]);",
      "    DB::commit();",
      "",
      "    return redirect()->back()->with('success', 'Pesanan berhasil dibuat! ID: #' . \\$order->id);",
      "} catch (\\Exception \\$e) {",
      "    DB::rollBack();",
      "    return redirect()->back()->with('error', 'Gagal memproses pesanan: ' . \\$e->getMessage());",
      "}"
    ]
  }
