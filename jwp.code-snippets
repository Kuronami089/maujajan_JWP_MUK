{
  "JWP CRUD Controller": {
    "scope": "php",
    "prefix": "jwp-controller",
    "description": "Membuat Controller CRUD Lengkap untuk JWP",
    "body": [
      "<?php",
      "",
      "namespace App\\Http\\Controllers;",
      "",
      "use App\\Models\\${1:Event};",
      "use Illuminate\\Http\\Request;",
      "",
      "class ${1:Event}Controller extends Controller",
      "{",
      "    // 1. Tampilkan Semua Data",
      "    public function index()",
      "    {",
      "        \\$${2:events} = ${1:Event}::latest()->paginate(10);",
      "        return view('admin.${2:events}.index', compact('${2:events}'));",
      "    }",
      "",
      "    // 2. Form Tambah Data",
      "    public function create()",
      "    {",
      "        return view('admin.${2:events}.create');",
      "    }",
      "",
      "    // 3. Simpan Data Baru",
      "    public function store(Request \\$request)",
      "    {",
      "        \\$request->validate([",
      "            '${4:nama}' => 'required|string|max:255',",
      "            // Tambah validasi kolom lainnya",
      "        ]);",
      "",
      "        ${1:Event}::create(\\$request->all());",
      "",
      "        return redirect()->route('${2:events}.index')->with('success', 'Data ${1:Event} berhasil ditambahkan!');",
      "    }",
      "",
      "    // 4. Form Edit Data",
      "    public function edit(${1:Event} \\$${3:event})",
      "    {",
      "        return view('admin.${2:events}.edit', compact('${3:event}'));",
      "    }",
      "",
      "    // 5. Update Data",
      "    public function update(Request \\$request, ${1:Event} \\$${3:event})",
      "    {",
      "        \\$request->validate([",
      "            '${4:nama}' => 'required|string|max:255',",
      "            // Tambah validasi kolom lainnya",
      "        ]);",
      "",
      "        \\$${3:event}->update(\\$request->all());",
      "",
      "        return redirect()->route('${2:events}.index')->with('success', 'Data ${1:Event} berhasil diperbarui!');",
      "    }",
      "",
      "    // 6. Hapus Data",
      "    public function destroy(${1:Event} \\$${3:event})",
      "    {",
      "        \\$${3:event}->delete();",
      "        return redirect()->route('${2:events}.index')->with('success', 'Data ${1:Event} berhasil dihapus!');",
      "    }",
      "}"
    ]
  },

