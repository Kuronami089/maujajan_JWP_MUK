  "5. FC Update Method": {
    "scope": "php",
    "prefix": "jwp-fc-update",
    "description": "Method update() untuk validasi, ganti foto lama, dan update menu",
    "body": [
      "// Simpan perubahan menu ke database",
      "public function update(Request \\$request, ${1:Food} \\$food)",
      "{",
      "    // Validasi data input",
      "    \\$request->validate([",
      "        'name'        => 'required|string|max:255',",
      "        'category'    => 'required|in:${3:Makanan,Minuman,Cemilan}',",
      "        'price'       => 'required|numeric|min:0',",
      "        'description' => 'required|string',",
      "        'image'       => 'nullable|image|mimes:jpeg,png,jpg|max:2048',",
      "    ]);",
      "",
      "    \\$imagePath = \\$food->image;",
      "",
      "    // Jika upload gambar baru, hapus file gambar lama",
      "    if (\\$request->hasFile('image')) {",
      "        if (\\$food->image && Storage::disk('public')->exists(\\$food->image)) {",
      "            Storage::disk('public')->delete(\\$food->image);",
      "        }",
      "        \\$imagePath = \\$request->file('image')->store('${2:foods}', 'public');",
      "    }",
      "",
      "    // Perbarui data menu",
      "    \\$food->update([",
      "        'name'        => \\$request->name,",
      "        'category'    => \\$request->category,",
      "        'price'       => \\$request->price,",
      "        'description' => \\$request->description,",
      "        'image'       => \\$imagePath,",
      "    ]);",
      "",
      "    return redirect()->route('${2:foods}.index')->with('success', 'Data ${1:makanan} berhasil diperbarui!');",
      "}"
    ]
  },

  "6. FC Destroy Method": {
    "scope": "php",
    "prefix": "jwp-fc-destroy",
    "description": "Method destroy() untuk hapus file gambar dari storage & hapus record di DB",
    "body": [
      "// Hapus menu beserta file gambarnya",
      "public function destroy(${1:Food} \\$food)",
      "{",
      "    // Hapus file gambar jika ada",
      "    if (\\$food->image && Storage::disk('public')->exists(\\$food->image)) {",
      "        Storage::disk('public')->delete(\\$food->image);",
      "    }",
      "",
      "    // Hapus data dari database",
      "    \\$food->delete();",
      "",
      "    return redirect()->route('${2:foods}.index')->with('success', 'Data ${1:makanan} berhasil dihapus!');",
      "}"
    ]
  },

