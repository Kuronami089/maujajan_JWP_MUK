  "JWP Full CRUD Controller (With Image Upload)": {
    "scope": "php",
    "prefix": "jwp-controller",
    "description": "Controller CRUD 100% persis FoodController (Upload Gambar, Validasi, Delete Storage, Flash Message)",
    "body": [
      "<?php",
      "",
      "namespace App\\Http\\Controllers;",
      "",
      "use App\\Models\\${1:Food};",
      "use Illuminate\\Http\\Request;",
      "use Illuminate\\Support\\Facades\\Storage;",
      "",
      "class ${1:Food}Controller extends Controller",
      "{",
      "    // Menampilkan daftar data",
      "    public function index()",
      "    {",
      "        \\$${3:food} = ${1:Food}::latest()->paginate(10);",
      "        return view('admin.${2:foods}.index', compact('${3:food}'));",
      "    }",
      "",
      "    // Menampilkan form tambah",
      "    public function create()",
      "    {",
      "        return view('admin.${2:foods}.create');",
      "    }",
      "",
      "    // Simpan data baru ke database",
      "    public function store(Request \\$request)",
      "    {",
      "        // Validasi data input",
      "        \\$request->validate([",
      "            'name'        => 'required|string|max:255',",
      "            'category'    => 'required|string',",
      "            'price'       => 'required|numeric|min:0',",
      "            'description' => 'required|string',",
      "            'image'       => 'nullable|image|mimes:jpeg,png,jpg|max:2048',",
      "        ]);",
      "",
      "        // Upload gambar jika ada",
      "        \\$imagePath = null;",
      "        if (\\$request->hasFile('image')) {",
      "            \\$imagePath = \\$request->file('image')->store('${2:foods}', 'public');",
      "        }",
      "",
      "        // Simpan data",
      "        ${1:Food}::create([",
      "            'name'        => \\$request->name,",
      "            'category'    => \\$request->category,",
      "            'price'       => \\$request->price,",
      "            'description' => \\$request->description,",
      "            'image'       => \\$imagePath,",
      "        ]);",
      "",
      "        return redirect()->route('${2:foods}.index')->with('success', 'Data ${1:Food} berhasil ditambahkan!');",
      "    }",
      "",
      "    public function show(${1:Food} \\$${3:food})",
      "    {",
      "        //",
      "    }",
      "",
      "    // Menampilkan form edit",
      "    public function edit(${1:Food} \\$${3:food})",
      "    {",
      "        return view('admin.${2:foods}.edit', compact('${3:food}'));",
      "    }",
      "",
      "    // Simpan perubahan ke database",
      "    public function update(Request \\$request, ${1:Food} \\$${3:food})",
      "    {",
      "        // Validasi data input",
      "        \\$request->validate([",
      "            'name'        => 'required|string|max:255',",
      "            'category'    => 'required|string',",
      "            'price'       => 'required|numeric|min:0',",
      "            'description' => 'required|string',",
      "            'image'       => 'nullable|image|mimes:jpeg,png,jpg|max:2048',",
      "        ]);",
      "",
      "        \\$imagePath = \\$${3:food}->image;",
      "",
      "        // Jika upload gambar baru, hapus file gambar lama",
      "        if (\\$request->hasFile('image')) {",
      "            if (\\$${3:food}->image && Storage::disk('public')->exists(\\$${3:food}->image)) {",
      "                Storage::disk('public')->delete(\\$${3:food}->image);",
      "            }",
      "            \\$imagePath = \\$request->file('image')->store('${2:foods}', 'public');",
      "        }",
      "",
      "        // Perbarui data",
      "        \\$${3:food}->update([",
      "            'name'        => \\$request->name,",
      "            'category'    => \\$request->category,",
      "            'price'       => \\$request->price,",
      "            'description' => \\$request->description,",
      "            'image'       => \\$imagePath,",
      "        ]);",
      "",
      "        return redirect()->route('${2:foods}.index')->with('success', 'Data ${1:Food} berhasil diperbarui!');",
      "    }",
      "",
      "    // Hapus data beserta file gambarnya",
      "    public function destroy(${1:Food} \\$${3:food})",
      "    {",
      "        // Hapus file gambar jika ada",
      "        if (\\$${3:food}->image && Storage::disk('public')->exists(\\$${3:food}->image)) {",
      "            Storage::disk('public')->delete(\\$${3:food}->image);",
      "        }",
      "",
      "        // Hapus data dari database",
      "        \\$${3:food}->delete();",
      "",
      "        return redirect()->route('${2:foods}.index')->with('success', 'Data ${1:Food} berhasil dihapus!');",
      "    }",
      "}"
    ]
  },

